    "# Stellar masses"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 71,
   "id": "acdc9ded-14ec-407c-8f59-38ff38164cc6",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "C&O mass range: 0.21 to 60.0 solar masses\n",
      "C&O MV range:   -5.1 to 12.8\n",
      "\n",
      "Stars with mass estimates: 714\n",
      "Mass range: 0.55 to 5.69 solar masses\n",
      "Median mass: 0.81 solar masses\n",
      "\n",
      " Mass Distribution \n",
      "      <0.5 M☉:     0 stars\n",
      "     0.5-1 M☉:   515 stars\n",
      "     1-1.5 M☉:   121 stars\n",
      "     1.5-2 M☉:    38 stars\n",
      "       2-3 M☉:    26 stars\n",
      "       3-5 M☉:    10 stars\n",
      "      5-10 M☉:     4 stars\n",
      "     10-20 M☉:     0 stars\n",
      "       >20 M☉:     0 stars\n"
     ]
    },
    {
